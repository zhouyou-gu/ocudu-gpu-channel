From cdb02542355b7f35c1e5eff1fbe8c019a923fb1b Mon Sep 17 00:00:00 2001
From: Robert Falkenberg <robert.falkenberg@srs.io>
Date: Tue, 16 Jun 2026 14:28:59 +0200
Subject: [PATCH] cmake: remove outdated Boost library `system` (only for
 Ubuntu 18.04 + UHD)

The `system` library was removed in newer Boost versions.
It was only needed for Ubuntu 18.04 + UHD as a transitive dependency.
---
 CMakeLists.txt | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 37063999d..7084258a5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -260,9 +260,7 @@ endif(BUILD_STATIC)
 set(BOOST_REQUIRED_COMPONENTS
   program_options
 )
-if(UHD_FOUND) # Ubuntu 18.04 requires component 'system' to link UHD
-  list(APPEND BOOST_REQUIRED_COMPONENTS "system")
-endif(UHD_FOUND)
+
 if(UNIX AND EXISTS "/usr/lib64")
   list(APPEND BOOST_LIBRARYDIR "/usr/lib64") #fedora 64-bit fix
 endif(UNIX AND EXISTS "/usr/lib64")
-- 
2.43.0

From 0a6c6437825d6816121b13b60e6872c4fe32c0e2 Mon Sep 17 00:00:00 2001
