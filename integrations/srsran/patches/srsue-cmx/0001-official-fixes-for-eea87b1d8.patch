2.43.0

From 4cb86aeab7e04695fb2d0f6b09627b566036b5a2 Mon Sep 17 00:00:00 2001
From: Robert Falkenberg <robert.falkenberg@srs.io>
Date: Tue, 16 Jun 2026 14:32:19 +0200
Subject: [PATCH] cmake: enable backward compat for `FindBoost` policy.

This avoids the following warning:

Policy CMP0167 is not set: The FindBoost module is removed.  Run "cmake
--help-policy CMP0167" for policy details.  Use the cmake_policy command to
set the policy and suppress this warning.
---
 CMakeLists.txt | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 009c19e79..e45740709 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -19,6 +19,11 @@ endif(${CMAKE_SOURCE_DIR} STREQUAL ${CMAKE_BINARY_DIR})
 # Project setup
 ########################################################################
 cmake_minimum_required(VERSION 3.10)
+
+if(POLICY CMP0167) # CMAKE 3.30+ changed the FindBoost policy.
+  cmake_policy(SET CMP0167 OLD) # Use old behavior.
+endif()
+
 project( SRSRAN )
 message( STATUS "CMAKE_SYSTEM: " ${CMAKE_SYSTEM} )
 message( STATUS "CMAKE_SYSTEM_PROCESSOR: " ${CMAKE_SYSTEM_PROCESSOR} )
-- 
2.43.0

