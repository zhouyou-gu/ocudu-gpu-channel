From 5da97cb582188dad2ff68281b04fe2ab6b6c39e3 Mon Sep 17 00:00:00 2001
From: Andre Puschmann <andre@srs.io>
Date: Mon, 3 Nov 2025 11:33:48 +0100
Subject: [PATCH] ue,nas: do not include NSSAI IE in NAS registration request

according to 24.501 sec 4.4.6 a the NSSAI IE should not be
sent in cleartext in a NAS registration request

Thanks to @s5uishida for flagging in https://github.com/srsran/srsRAN_4G/pull/1214

Imported here for internal CI checking
---
 srsue/src/stack/upper/nas_5g.cc | 6 ------
 1 file changed, 6 deletions(-)

diff --git a/srsue/src/stack/upper/nas_5g.cc b/srsue/src/stack/upper/nas_5g.cc
index a3f1cc21b..34333f1a7 100644
--- a/srsue/src/stack/upper/nas_5g.cc
+++ b/srsue/src/stack/upper/nas_5g.cc
@@ -269,12 +269,6 @@ int nas_5g::send_registration_request()
   reg_req.ue_security_capability_present = true;
   fill_security_caps(reg_req.ue_security_capability);
 
-  if (cfg.enable_slicing) {
-    reg_req.requested_nssai_present = true;
-    s_nssai_t nssai;
-    set_nssai(nssai);
-    reg_req.requested_nssai.s_nssai_list.push_back(nssai);
-  }
   if (initial_registration_request_stored.pack(pdu) != SRSASN_SUCCESS) {
     logger.error("Failed to pack registration request");
     return SRSRAN_ERROR;
-- 
