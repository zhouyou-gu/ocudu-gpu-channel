+      received_crueid = subpdu.get_ue_con_res_id_ce_packed();
+    }
+  }
+  if (contention_id_check && !contention_id_check(received_crueid)) {
+    logger.warning("Dropping Temp C-RNTI PDU: Contention Resolution ID 0x%lx is not ours", received_crueid);
+    return;
+  }
   handle_pdu(rx_pdu_tcrnti, std::move(pdu));
 }
 
