+uint32_t proc_ra_nr::select_preamble_index()
+{
+  // 64 contention-based preambles per SSB is OCUDU's default
+  // (ssb-perRACH-OccasionAndCB-PreamblesPerSSB one/n64);
+  // SRSUE_PRACH_NUM_CB_PREAMBLES narrows the range for other cells.
+  static const char* fixed_env = std::getenv("SRSUE_PRACH_PREAMBLE_INDEX");
+  if (fixed_env != nullptr && *fixed_env != '\0') {
+    return static_cast<uint32_t>(std::strtoul(fixed_env, nullptr, 10)) % 64;
+  }
+  static const char* range_env = std::getenv("SRSUE_PRACH_NUM_CB_PREAMBLES");
+  uint32_t           range     = 64;
+  if (range_env != nullptr && *range_env != '\0') {
+    range = std::max<uint32_t>(1, std::min<uint32_t>(64, std::strtoul(range_env, nullptr, 10)));
+  }
+  static std::mt19937 generator(static_cast<uint32_t>(std::random_device{}()) ^
+                                (static_cast<uint32_t>(getpid()) << 16) ^
+                                static_cast<uint32_t>(std::chrono::steady_clock::now().time_since_epoch().count()));
+  return std::uniform_int_distribution<uint32_t>(0, range - 1)(generator);
+}
