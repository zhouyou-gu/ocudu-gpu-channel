+/// Local patch (ocudu-gpu-channel, ocudu-zmq-lower-phy-profile): with a ZMQ radio the application
+/// forces the blocking (sequential) lower PHY, so the DL baseband is produced one block per received
+/// UL block and the lock-step loop through an external channel emulator serialises the two radios.
+/// OCUDU_ZMQ_LOWER_PHY_PROFILE=single|dual|triple keeps that threaded profile with ZMQ instead, so the
+/// DL runs ahead of UL reception up to rx_to_tx_max_delay. Unset or empty keeps the stock behaviour.
+#include <cstdlib>
+#include <optional>
+#include <string_view>
+inline std::optional<lower_phy_thread_profile> zmq_lower_phy_profile_override()
+{
+  const char* value = std::getenv("OCUDU_ZMQ_LOWER_PHY_PROFILE");
+  if (value == nullptr || *value == '\0') {
+    return std::nullopt;
+  }
+  std::string_view name(value);
+  if (name == "single") {
+    return lower_phy_thread_profile::single;
+  }
+  if (name == "dual") {
+    return lower_phy_thread_profile::dual;
+  }
+  if (name == "triple") {
+    return lower_phy_thread_profile::triple;
+  }
+  return std::nullopt;
+}
