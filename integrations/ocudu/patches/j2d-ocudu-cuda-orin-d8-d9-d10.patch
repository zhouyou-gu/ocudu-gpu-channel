+    for (int t = 0; t < FD_SMOOTH_FILTER_LEN; t++) {
+        int src_pilot = global_pilot + (t - HALF_FILTER);
+        tap_ok[t] = (src_pilot >= 0 && src_pilot < total_pilots);
+        tap_re[t] = tap_im[t] = 0.0f;
+        if (!tap_ok[t]) continue;
+        int src_idx = sym_base + (src_pilot / nof_pilots) * prb_stride + inner +
+                      pusch_dmrs_sc_offset(dmrs_type, cdm, src_pilot % nof_pilots);
