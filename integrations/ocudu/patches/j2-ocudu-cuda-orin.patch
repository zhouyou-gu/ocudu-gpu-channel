+  /// A managed-memory hint (prefetch or advice) that the device does not implement. Devices without
+  /// ConcurrentManagedAccess (e.g. Jetson Orin) return cudaErrorInvalidDevice here rather than
+  /// cudaErrorNotSupported; both mean "no-op", not failure. The error is consumed so that a later,
+  /// unrelated cudaGetLastError() check does not pick it up.
+  static bool managed_hint_unsupported(cudaError_t status, int device)
+  {
+    if (status == cudaErrorNotSupported) {
+      (void)cudaGetLastError();
+      return true;
+    }
+    if (status == cudaErrorInvalidDevice) {
+      int concurrent = 1;
+      if ((cudaDeviceGetAttribute(&concurrent, cudaDevAttrConcurrentManagedAccess, device) == cudaSuccess) &&
+          (concurrent == 0)) {
+        (void)cudaGetLastError();
+        return true;
+      }
+    }
+    return false;
+  }
+
+  /// Best-effort managed-memory advice: a refusal must not leave a pending CUDA error behind.
+  static void advise_best_effort(cudaError_t status)
+  {
+    if (status != cudaSuccess) {
+      (void)cudaGetLastError();
+    }
+  }
