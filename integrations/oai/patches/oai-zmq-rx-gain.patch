   };
 
+// Digital gain on the float -> int16 RX conversion. The ZMQ path has no AGC,
+// so the samples reach the PHY at whatever level the far end transmits; the
+// UE's fixed-point receive chain is sized for ~TARGET_RX_POWER (50 dB) and
+// degrades well before int16 full scale. rx_gain_db plays the role of the RF
+// receive gain a radio would set. Written once in device_init, read by the
+// RX poll threads started after it.
+static float zmq_rx_factor = c16_t_to_cf_t_factor;
+
 const size_t sample_size = sizeof(cf_t);
 const size_t rx_buffer_size = sample_size * 300000;
 
