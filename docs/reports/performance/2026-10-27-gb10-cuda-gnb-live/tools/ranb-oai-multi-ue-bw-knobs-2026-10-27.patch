+def uecap_with_30khz_cell(text: str, bw: int) -> str:
+    """Make sure the capability has 30 kHz DL and UL per-CC feature sets for the cell bandwidth.
+
+    20 MHz: the audited UL edit. 100 MHz: the stock file already has both. Otherwise copy the 30 kHz 40 MHz
+    DL/UL entries with the bandwidth tag changed (the nrUE picks the per-CC set whose SCS and bandwidth
+    equal the cell's, config_ue.c)."""
+    if bw == 20:
+        return uecap_with_ul_30khz_20mhz(text)
+    for tag in ("FeatureSetDownlinkPerCC", "FeatureSetUplinkPerCC"):
+        blocks = re.findall(rf"<{tag}>.*?</{tag}>", text, re.S)
+        if any("<kHz30/>" in b and f"<mhz{bw}/>" in b for b in blocks):
+            continue
