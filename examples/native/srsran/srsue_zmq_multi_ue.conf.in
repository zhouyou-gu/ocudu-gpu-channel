[rf]
freq_offset = 0
tx_gain = 50
rx_gain = 40
srate = 23.04e6
nof_antennas = 1
device_name = zmq
device_args = tx_port=tcp://127.0.0.1:@UE_TX_PORT@,rx_port=tcp://127.0.0.1:@UE_RX_PORT@,base_srate=23.04e6

[rat.eutra]
dl_earfcn = 2850
nof_carriers = 0

[rat.nr]
bands = 3
nof_carriers = 1
max_nof_prb = 106
nof_prb = 106

[usim]
mode = soft
algo = milenage
opc = 63BFA50EE6523365FF14C1F45F88737D
k = 00112233445566778899AABBCCDDEEFF
imsi = @UE_IMSI@
imei = @UE_IMEI@

[rrc]
release = 15
ue_category = 4

[nas]
apn = internet
apn_protocol = ipv4

[gw]
netns = @UE_NETNS@
ip_devname = tun_srsue
ip_netmask = 255.255.255.0

[log]
all_level = info
filename = @SRSUE_LOG@

[pcap]
enable = none
