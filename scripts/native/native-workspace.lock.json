          "commit": "940dd5fa9f3917913fd487b13dfddfacd0ded06e",
          "materialises_at": "builds/oai-zmq-release/asn1c_gen-prefix/src/asn1c_gen",
          "name": "asn1c",
          "note": "Recorded so the transitive source is not invisible, but deliberately NOT a git_sources entry: it only exists after the OAI build runs, so requiring it would make the workspace check fail on a clean tree.",
