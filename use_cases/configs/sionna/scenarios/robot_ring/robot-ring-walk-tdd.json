{
  "name": "robot-ring-walk-tdd",
  "description": "robot-ring-walk.json for the TDD n78 20 MHz / 30 kHz multi-UE gate with OAI nrUEs (X3, CROSSTALK_MILESTONES.md): the same ring scene and 0.2 m/s walks, the four gNB<->UE links as sionna_rt. The bridge traces every link at the one TDD carrier (3489.42 MHz, dl_arfcn 632628), which the gate passes as --carrier-frequency-hz from the renderer's cell metadata.",
  "scene": "robot_ring",
  "simple_road": false,
  "solver": {
    "max_depth": 3,
    "samples_per_source": 200000,
    "seed": 42,
    "path_polylines": 6,
    "propagation": {
      "los": true,
      "specular_reflection": true,
      "diffuse_reflection": false,
      "refraction": true,
      "diffraction": false
    }
  },
  "nodes": {
    "gnb0": {
      "start_m": [
        15.0,
        0.0,
        8.0
      ],
      "mobility": "fixed",
      "array": {
        "rows": 1,
        "cols": 1,
        "pattern": "iso",
        "polarization": "V"
      }
    },
    "ue0": {
      "mobility": "robot",
      "route_m": [
        [
          2.0,
          3.4,
          0.4
        ],
        [
          2.0,
          -3.4,
          0.4
        ]
      ],
      "route_mode": "pingpong",
      "speed_mps": 0.2,
      "array": {
        "rows": 1,
        "cols": 1,
        "pattern": "iso",
        "polarization": "V"
      }
    },
    "ue1": {
      "mobility": "robot",
      "route_m": [
        [
          -2.0,
          3.4,
          0.4
        ],
        [
          -2.0,
          -3.4,
          0.4
        ]
      ],
      "route_mode": "pingpong",
      "speed_mps": 0.2,
      "array": {
        "rows": 1,
        "cols": 1,
        "pattern": "iso",
        "polarization": "V"
      }
    }
  },
  "links": [
    {
      "from": "gnb0",
      "to": "ue0",
      "direction": "downlink",
      "model": "sionna_rt"
    },
    {
      "from": "gnb0",
      "to": "ue1",
      "direction": "downlink",
      "model": "sionna_rt"
    },
    {
      "from": "ue0",
      "to": "gnb0",
      "direction": "uplink",
      "model": "sionna_rt"
    },
    {
      "from": "ue1",
      "to": "gnb0",
      "direction": "uplink",
      "model": "sionna_rt"
    }
  ]
}
